# Configuración del frontend — plantilla SIN valores. Copiar a .env.
# Dirección del backend (por defecto http://localhost:3000)
VITE_API_URL=
# Identificador de cliente de Google y de Microsoft (los mismos del backend).
# Vacíos: los botones muestran el mensaje "no configurado" del backend.
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
