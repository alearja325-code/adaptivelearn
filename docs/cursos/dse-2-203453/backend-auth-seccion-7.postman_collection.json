        {
          "name": "Ruta solo para docentes (RolesGuard)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/example/docente",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "example",
                "docente"
              ]
            },
            "description": "Guía, sección 6, ExampleController.adminRoute. La guía usa @Roles('admin'); este modelo solo tiene docente y estudiante (spec 20). El usuario recién registrado aún no tiene rol, así que RolesGuard lo rechaza (403)."
          },
          "response": []
        }
      ]
    }
  ],
