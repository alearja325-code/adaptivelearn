    {
      "name": "Acceso de AdaptiveLearn (E-01 a E-12)",
      "item": [
        {
          "name": "E-01 Registrar al docente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('tokenDocente', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Crea docente@example.com. El código de 6 dígitos llega al correo; sin MAIL_HOST, aparece en la consola del servidor: copiarlo en la variable de colección `codigo`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"docente@example.com\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "E-03 Reenviar el código",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('ok', () => pm.expect(pm.response.json()).to.eql({ ok: true }));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/reenviar-codigo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "reenviar-codigo"
              ]
            },
            "description": "Responde 201 { ok: true } siempre (RNF-07). Antes de 30 s desde el último código, no envía otro.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"docente@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "E-02 Verificar el correo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('verificado', () => pm.expect(pm.response.json().user.estadoVerificacion).to.eql('verificado'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenDocente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/verificar-correo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verificar-correo"
              ]
            },
            "description": "Usa la variable `codigo` (de la consola del servidor o del correo).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"{{codigo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "E-06 Completar el perfil y elegir el rol",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('Sesión de docente con su id (R2)', () => { const j = pm.response.json(); pm.expect(j.user.role).to.eql('docente'); const p = JSON.parse(atob(j.token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); pm.expect(p.idDocente).to.be.a('number'); });",
                  "pm.collectionVariables.set('tokenDocente', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenDocente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/elegir-rol",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "elegir-rol"
              ]
            },
            "description": "multipart/form-data: role, nombres, apellidos y, opcional, foto (JPG o PNG, hasta 5 MB). Una sola vez: el rol no se cambia.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "role",
                  "value": "docente",
                  "type": "text"
                },
                {
                  "key": "nombres",
                  "value": "Ana María",
                  "type": "text"
                },
                {
                  "key": "apellidos",
                  "value": "Pérez",
                  "type": "text"
                },
                {
                  "key": "foto",
                  "type": "file",
                  "src": [],
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "E-11 Ver el propio perfil",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('perfil', () => pm.expect(pm.response.json().user.perfil.nombres).to.eql('Ana María'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
