# Configuración del backend — plantilla SIN valores.
# Copiar a .env (que nunca se sube) y completar. Ver README.md.

# Puerto del servidor (por defecto 3000)
PORT=

# Base de datos MySQL 8
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# JWT: secreto largo y al azar (también es la clave del hash de los códigos)
JWT_SECRET=
# Vida del token de sesión, en segundos (3600 = 1 hora)
JWT_EXPIRATION=

# Correo (nota R5). Cuenta del sistema: adaptivelearn.sistema@gmail.com.
# Gmail: MAIL_HOST smtp.gmail.com, MAIL_PORT 587 y, en MAIL_PASSWORD, una
# contraseña de aplicación de esa cuenta. Sin MAIL_HOST, los códigos se
# escriben en la consola del servidor (solo desarrollo).
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Google y Microsoft (E-04, E-05): el identificador de cliente de cada uno.
# Vacíos: esas rutas responden 503 "no configurado".
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=

# Tarea nocturna (ADR-039). Por defecto: "0 3 * * *", America/Bogota, 7 días.
LIMPIEZA_CRON=
LIMPIEZA_ZONA_HORARIA=
LIMPIEZA_DIAS_SIN_TERMINAR=

# CORS: dirección del frontend que puede llamar al backend (varias, separadas
# por comas). Por defecto: http://localhost:5173 (el frontend de desarrollo).
CORS_ORIGIN=

# Carpeta de las fotos de perfil (por defecto: uploads)
UPLOADS_DIR=

# Base de datos de las pruebas e2e (se BORRA y se recrea en cada corrida).
# Por defecto: el nombre de DB_DATABASE seguido de _pruebas.
DB_DATABASE_PRUEBAS=
